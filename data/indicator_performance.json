{
  "source": "historical backtest (Alpaca IEX daily OHLCV)",
  "horizons": [
    1,
    3,
    5,
    10,
    21
  ],
  "entry": "signal at close[i]; enter open[i+1]; exit close[i+h] \u2014 no same-bar look-ahead",
  "benchmark": "cross-sectional: forward return market-demeaned by same-day universe mean (beta-neutral)",
  "inference": "moving-block bootstrap over calendar dates, block_len=max(5, horizon) \u2014 overlap-aware: i.i.d.-date CIs read several times too tight on 10/21d. n_days = distinct dates, n_indep = independent blocks, n_obs = inflated ticker-day count",
  "out_of_sample": {
    "oos_frac": 0.3,
    "split_date": "2025-01-23 05:00:00+00:00",
    "note": "each cell.oos grades the held-out tail; holds_oos = full edge did not flip adverse there. Under-powered relative to the full window \u2014 a stability read, not a second proof."
  },
  "regime": {
    "definition": "risk_on = SPY above BOTH its 50d and 200d SMA, else other",
    "note": "cell.by_regime splits the edge; an edge only in risk_on is beta in disguise."
  },
  "multiple_testing": {
    "method": "Benjamini-Hochberg FDR",
    "q": 0.05,
    "cells": 35,
    "passed": 1,
    "expected_false": 1.8
  },
  "caveats": [
    "Survivorship / current-membership universe (today's popular()); delisted/dropped names absent \u2014 edges biased UP. Unfixable on Alpaca IEX.",
    "RVOL and gap are computed on IEX partial-tape volume / non-auction open \u2192 indicative, not tradeable, unlike close-based RSI/MACD (indicative_only=true).",
    "Thresholds are trading lore, graded IN-SAMPLE over a single (mostly bull) regime; treat any thin edge as unproven."
  ],
  "config": {
    "slippage_round_trip_pct": 0.5,
    "n_boot": 1000,
    "seed": 0
  },
