{
  "purpose": "Selection-aware audit of the indicator-proof family: DSR (is the FDR survivor's Sharpe real GIVEN it was the best of 35 trials?) and PBO (does the family's in-sample winner keep winning out of sample?).",
  "method": {
    "panel": "indicator_proof._combined \u2014 next-bar entry, market-demeaned, liquidity-floored",
    "common_scale": "per-date mean demeaned fired return, aggregated to non-overlapping 21-trading-day bins (family max horizon) before any Sharpe",
    "dsr": "Bailey-L\u00f3pez de Prado: PSR evaluated at E[max SR] of n_trials with the family's cross-trial SR variance",
    "pbo": "CSCV over C(10,5) contiguous train/test bisections; 21-day embargo at every block tail; zero-fill on silent dates",
    "portfolio_dsr": "\u00a710.1: every trial's fired events through the identical executable 5-slot simulator; DSR on the survivor's daily SPY-excess account series against the family's account-level SR dispersion",
    "fold_consistency": "5 contiguous folds, 21-day purge at each fold tail, moving-block CI per fold"
  },
  "conservatism": [
    "cross-trial SR variance includes the family's REAL edge dispersion \u2192 hurdle biased UP",
    "35 correlated trials treated as independent draws \u2192 E[max] biased UP",
    "short-horizon trials over-blocked at 21d \u2192 their noise widened, never narrowed"
  ],
  "caveats": [
    "same in-sample panel as the proof \u2014 survivorship / single-regime caveats carry over verbatim",
    "zero-fill makes silent dates literal 0.0 (flat book), diluting per-period Sharpe uniformly across trials"
  ],
